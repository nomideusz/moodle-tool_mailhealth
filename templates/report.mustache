{{!
    @template tool_mailhealth/report

    The mail health report.

    Context variables required for this template:
    * intro - What was checked.
    * summary - The number of problems found.
    * sections - The findings, grouped by check.
    * testurl - The core page for sending a test message.

    Example context (json):
    {
        "intro": "Checking example.org, the domain of the no-reply address.",
        "summary": "1 errors, 0 warnings",
        "sections": [{
            "heading": "SPF",
            "findings": [{"badge": "<span class=\"badge\">Error</span>", "message": "No SPF record was found."}]
        }],
        "testurl": "https://example.org/admin/testoutgoingmailconf.php"
    }
}}
<p>{{intro}}</p>
<p class="fw-bold font-weight-bold">{{summary}}</p>
{{#sections}}
    <h3 class="h5 mt-4">{{heading}}</h3>
    <table class="table table-sm generaltable tool_mailhealth-findings">
        <tbody>
            {{#findings}}
                <tr>
                    <td class="tool_mailhealth-status text-nowrap">{{{badge}}}</td>
                    <td>{{message}}</td>
                </tr>
            {{/findings}}
        </tbody>
    </table>
{{/sections}}
<p class="mt-4"><a class="btn btn-secondary" href="{{testurl}}">{{#str}}sendtest, tool_mailhealth{{/str}}</a></p>
